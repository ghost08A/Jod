{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "jod",
    "Audience": "jod-web",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 30,
    "RefreshTokenDays": 30
  },
  "Limits": {
    "JsonMaxDepth": 256,
    "RequestBodyMaxBytes": 1048576
  },
  "RateLimit": {
    "AuthRequestsPerMinute": 10,
    "RefreshRequestsPerMinute": 60
  },
  "Google": {
    "ClientId": ""
  },
  "Access": {
    "AllowedEmails": []
  }
}
